# Use the same public Firebase web configuration as the desktop Stock Stickies app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: use the same App Check site key as the desktop app.
VITE_RECAPTCHA_V3_SITE_KEY=

# Existing Ask K worker. Override only when deploying a different worker.
VITE_ASKK_API_URL=https://stock-stickies-askk.99redder.workers.dev/api/ask-k
